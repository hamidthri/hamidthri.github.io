---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const posts = (await getCollection('posts', ({ data }) => import.meta.env.PROD ? !data.draft : true))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Notes" description="Research notes and writing by Hamid Taheri on robotics, reinforcement learning and machine learning.">
  <section class="page-head">
    <div class="wrap">
      <div class="breadcrumb"><a href={import.meta.env.BASE_URL}>home</a> / notes</div>
      <h1>Notes</h1>
      <p class="lead">Research notes, paper walk-throughs and the occasional build log. Thinking out loud about robotics, RL and perception.</p>
    </div>
  </section>

  <section class="pad" style="padding-top:clamp(20px,4vh,40px)">
    <div class="wrap">
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-card reveal">
            <div class="pdate">{fmt(post.data.date)}</div>
            <div>
              <h3><a href={`${base}/blog/${post.id}`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
              <div class="tags">{post.data.tags.map((t) => <span class="tag-pill">{t}</span>)}</div>
            </div>
          </article>
        ))}
        {posts.length === 0 && <p class="lead">No notes published yet — check back soon.</p>}
      </div>
    </div>
  </section>
</Base>
