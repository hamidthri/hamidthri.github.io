---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { links, site } from '../lib/site';
---

<Base title="Contact" description="Get in touch with Hamid Taheri — open to PhD opportunities, research and engineering collaborations.">
  <section class="page-head">
    <div class="wrap">
      <div class="breadcrumb"><a href={import.meta.env.BASE_URL}>home</a> / contact</div>
    </div>
  </section>

  <section class="pad" style="padding-top:clamp(20px,5vh,50px)">
    <div class="wrap">
      <div class="contact-panel reveal">
        <h2>Let's build <em>intelligent systems</em><br />together.</h2>
        <p class="lead">
          I'm open to <b>PhD positions</b>, research collaborations and engineering work in
          robotics, computer vision and learning-based control. The fastest way to reach me is
          email — I read everything.
        </p>
        <div class="contact-links">
          <a class="btn primary" href={links.email}><Icon name="mail" size={15} /> {site.email}</a>
          <a class="btn" href={links.github} target="_blank" rel="noopener"><Icon name="github" size={15} /> GitHub</a>
          <a class="btn" href={links.scholar} target="_blank" rel="noopener"><Icon name="scholar" size={15} /> Scholar</a>
          <a class="btn" href={links.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={15} /> LinkedIn</a>
          <a class="btn" href={links.cv} target="_blank" rel="noopener"><Icon name="download" size={15} /> CV</a>
        </div>
        <p style="font-family:var(--mono);font-size:12px;color:var(--faint);margin-top:30px;letter-spacing:.03em">
          based in {site.location}
        </p>
      </div>
    </div>
  </section>
</Base>
