---
import { site, links } from '../lib/site';
import Icon from './Icon.astro';
const year = new Date().getFullYear();

const social = [
  { href: links.github, label: 'GitHub', icon: 'github', ext: true },
  { href: links.scholar, label: 'Scholar', icon: 'scholar', ext: true },
  { href: links.linkedin, label: 'LinkedIn', icon: 'linkedin', ext: true },
  { href: links.email, label: 'Email', icon: 'mail', ext: false },
];
---

<footer class="site-footer">
  <div class="f-brand">© {year} <b>{site.name}</b> · {site.location}</div>
  <div class="f-links">
    {social.map((s) => (
      <a href={s.href} {...(s.ext ? { target: '_blank', rel: 'noopener' } : {})}>
        <Icon name={s.icon} size={14} /> {s.label}
      </a>
    ))}
  </div>
</footer>
