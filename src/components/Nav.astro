---
import { site, navItems } from '../lib/site';

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
const withBase = (p: string) => import.meta.env.BASE_URL.replace(/\/$/, '') + p;
---

<nav class="site-nav" id="nav" aria-label="Primary">
  <a class="brand" href={withBase('/')} aria-label={`${site.name} — home`} title="Home">
    <span class="brand-mark" aria-hidden="true">
      <!-- HT monogram: tightly-kerned geometric H + T, single teal gradient -->
      <svg viewBox="0 0 24 24" fill="none">
        <defs>
          <linearGradient id="ht-mark" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5cf2ea" />
            <stop offset="1" stop-color="#16b8b0" />
          </linearGradient>
        </defs>
        <g fill="url(#ht-mark)">
          <!-- H -->
          <rect x="3" y="5" width="2.8" height="14" />
          <rect x="9" y="5" width="2.8" height="14" />
          <rect x="3" y="10.6" width="8.8" height="2.8" />
          <!-- T -->
          <rect x="12.2" y="5" width="8.8" height="2.8" />
          <rect x="15.2" y="5" width="2.8" height="14" />
        </g>
      </svg>
    </span>
    <span class="brand-text">
      <b>{site.name}</b>
      <span class="brand-role">Robotics · Perception · RL</span>
    </span>
  </a>

  <div class="nav-right">
    <div class="nav-links" id="nav-links">
      {navItems.map((item) => (
        <a href={withBase(item.href)} class={isActive(item.href) ? 'active' : undefined}>{item.label}</a>
      ))}
    </div>

    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch theme" title="Switch theme">
      <svg class="ico-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 14.5A8 8 0 1 1 9.5 4a6.2 6.2 0 0 0 10.5 10.5Z" />
      </svg>
      <svg class="ico-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>

    <button class="nav-toggle" id="nav-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-links">
      <svg class="ico-menu" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="ico-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div class="nav-scrim" id="nav-scrim" aria-hidden="true"></div>
</nav>
