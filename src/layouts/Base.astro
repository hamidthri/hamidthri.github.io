---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image, type, jsonLd, noindex } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#060911" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <SEO title={title} description={description} image={image} type={type} jsonLd={jsonLd} noindex={noindex} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- loader -->
    <div id="loader" aria-hidden="true">
      <div class="boot" id="boot">initializing perception stack</div>
      <div class="bar"><i></i></div>
    </div>

    <!-- custom cursor -->
    <div class="cursor-ring" id="cring" aria-hidden="true"></div>
    <div class="cursor-dot" id="cdot" aria-hidden="true"></div>

    <Nav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
